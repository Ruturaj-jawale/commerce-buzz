APP_NAME=saas-mcp
APP_ENV=development
DEBUG=true
APP_VERSION=0.1.0

# Free local database:
DATABASE_URL=sqlite:///./saas_mcp.db
# Free hosted PostgreSQL option (Supabase):
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres

SECRET_KEY=change-me

MCP_SERVER_NAME=saas-mcp
MCP_SERVER_VERSION=0.1.0

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Dedicated worker polling interval for durable ingestion jobs.
INGESTION_WORKER_POLL_SECONDS=2
INGESTION_WORKER_MAX_ATTEMPTS=3
INGESTION_WORKER_LEASE_SECONDS=300
MAX_INGESTION_PAYLOAD_BYTES=262144
# Scanned PDF imports are disabled by default. Enabling requires the Tesseract
# OCR executable and Poppler on the backend host/container.
PDF_OCR_ENABLED=false
PDF_OCR_LANGUAGE=eng
PDF_OCR_DPI=200
PDF_OCR_MAX_PAGES=20
# Required to create an organization, including in development.
BOOTSTRAP_TOKEN=replace-this-with-a-random-bootstrap-token
API_KEY_PEPPER=replace-this-with-a-random-api-key-pepper
